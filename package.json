{
  "name": "@xumi0920/dsh-browser-harness",
  "version": "1.0.0",
  "description": "DSH native browser tools (browser_*) written in TypeScript on a zero-dependency CDP core, driving a dedicated, logged-in Chromium-based browser (Chrome, Edge, Brave, Chromium, Vivaldi, Opera, Arc) with per-task Chrome tab groups.",
  "type": "module",
  "license": "MIT",
  "author": "Xumi0920",
  "icon": "./icon.svg",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xumi0920/dsh-browser-harness.git"
  },
  "homepage": "https://github.com/Xumi0920/dsh-browser-harness#readme",
  "bugs": {
    "url": "https://github.com/Xumi0920/dsh-browser-harness/issues"
  },
  "main": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": "./dist/lib/index.js",
    "./package.json": "./package.json",
    "./core": "./dist/src/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "bin": {
    "bh": "dist/bin/bh.js"
  },
  "files": [
    "dist/",
    "cordis.patch.yml",
    "extension/",
    "skills/",
    "locale/",
    "icon.svg",
    "README.md",
    "README.en.md",
    "SECURITY.md",
    "docs/",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.extension.json",
    "build:tests": "npm run build && tsc -p tsconfig.tests.json",
    "test": "npm run build:tests && node --test \"dist-tests/unit/**/*.test.js\"",
    "test:integration": "npm run build:tests && node --test \"dist-tests/integration/**/*.test.js\"",
    "test:all": "npm run build:tests && node --test \"dist-tests/**/*.test.js\"",
    "verify": "npm run build && tsc -p tsconfig.scripts.json && node dist-scripts/verify.js",
    "fixture": "npm run build:tests && node dist-tests/fixtures/server.js",
    "doctor": "node dist/bin/bh.js doctor"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "browser",
    "cdp",
    "chrome",
    "chromium",
    "edge",
    "brave",
    "tab-groups",
    "automation",
    "agent",
    "skill",
    "typescript"
  ],
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "semver": "^7.8.5",
    "typescript": "^7.0.2"
  }
}
