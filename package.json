{
  "name": "@xumi0920/dsh-browser-harness",
  "version": "0.3.2",
  "description": "DSH native browser tools (browser_*) backed by a zero-dependency CDP core driving a dedicated, logged-in Chromium-based browser (Chrome, Edge, Brave, Chromium, Vivaldi, Opera, Arc), with per-task Chrome tab groups for harness-created tabs.",
  "type": "module",
  "license": "MIT",
  "author": "Xumi0920",
  "icon": "./icon.svg",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xumi0920/dsh-browser-harness.git"
  },
  "homepage": "https://github.com/Xumi0920/dsh-browser-harness#readme",
  "bugs": {
    "url": "https://github.com/Xumi0920/dsh-browser-harness/issues"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./core": "./src/index.mjs",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "bin": {
    "bh": "./bin/bh.mjs"
  },
  "files": [
    "lib/",
    "src/",
    "bin/",
    "cordis.patch.yml",
    "extension/",
    "skills/",
    "locale/",
    "icon.svg",
    "README.md",
    "README.en.md",
    "docs/",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22",
    "dsh": "0.2.1-rc.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test \"tests/unit/**/*.test.mjs\"",
    "test:integration": "node --test \"tests/integration/**/*.test.mjs\"",
    "test:all": "node --test \"tests/**/*.test.mjs\"",
    "verify": "node scripts/verify.mjs",
    "doctor": "node bin/bh.mjs doctor"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "browser",
    "cdp",
    "chrome",
    "chromium",
    "edge",
    "brave",
    "tab-groups",
    "automation",
    "agent",
    "skill"
  ]
}
